<body>
<div id="app" class="app"><main id="screen" class="screen" aria-live="polite"></main><nav id="bottomNav" class="bottom-nav"></nav><div id="toast" class="toast" role="status"></div></div>
<script>
(() => {
  'use strict';
  const storageKey = 'million_bank_v1';
  const defaultState = () => ({balance:9885, transactions:[], user:'Даниил Н.', version:1});
  let state;
  try { const saved = JSON.parse(localStorage.getItem(storageKey)); state = saved && saved.version === 1 && Array.isArray(saved.transactions) ? saved : defaultState(); } catch { state = defaultState(); }
  const save = () => { try { localStorage.setItem(storageKey, JSON.stringify(state)); } catch {} };
  const app = document.getElementById('app');
  const screen = document.getElementById('screen');
  const bottomNav = document.getElementById('bottomNav');
  const toastEl = document.getElementById('toast');
