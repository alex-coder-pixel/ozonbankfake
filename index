            Служба поддержки Ozon Банка: <a href="tel:88005558982">8 (800) 555-89-82</a>
          </div>
          
          <div class="receipt-stamp-block">
            <div class="stamp-frame">
              <div class="stamp-frame-text">
                ООО «ОЗОН БАНК»<br>
                БИК 044525068 ИНН 9703077050<br>
                К/С 30101810645374525068<br>
                ДЛЯ ДОКУМЕНТОВ<br>
                КНЯЗЕВ Н.Н.
              </div>
            </div>
          </div>
        </div>
        
        <button class="receipt-share-btn" data-action="share-receipt">Поделиться</button>
      </div>
    </div>
    `;
  }

  function parseAmount(value){const x=Number(String(value||'').replace(/\s/g,'').replace(',','.'));return Number.isFinite(x)?Math.round(x*100)/100:0;}
  function validate(){const d=digits(form.target);if(form.type==='phone'&&!([10,11].includes(d.length)))return 'Укажите номер телефона из 10 или 11 цифр.';if(form.type==='card'&&d.length<16)return 'Укажите номер карты из 16–19 цифр.';if(form.type==='card'&&d.length>19)return 'Номер карты слишком длинный.';if(form.surname.trim().length<2)return 'Укажите фамилию получателя.';if(!/^[A-Za-zА-Яа-яЁё]$/.test(form.initial.trim()))return 'Укажите первую букву имени.';const amount=parseAmount(form.amount);if(amount<=0)return 'Введите сумму больше нуля.';if(amount>10000000)return 'Максимальная сумма одного перевода — 10 000 000 ₽.';if(amount>state.balance)return 'Недостаточно средств на счёте.';return ''}
  function completeTransfer(){const amount=parseAmount(form.amount);const t={id:'QB-'+Date.now().toString(36).toUpperCase(),kind:'debit',amount,type:form.type,target:shortTarget(form.type,form.target),name:recipientName(form),message:form.message,date:new Date().toISOString()};state.transactions.unshift(t);state.balance=Math.round((state.balance-amount)*100)/100;selectedTx=t;save();page='success';stack=[];render(true);}
  function resetQuest(){const ok=window.confirm('Сбросить баланс до 9 885 ₽ и удалить историю операций?');if(!ok)return;state=defaultState();save();selectedTx=null;form=freshForm('phone');tab('home');toast('Данные сброшены');}


  function vibrate(p){try{if(navigator.vibrate)navigator.vibrate(p);}catch{}}
  let transferBusy=false;
  function countUp(amount){const el=screen.querySelector('.ticket .spent');if(!el)return;const t0=performance.now(),dur=900;const step=now=>{const k=Math.min(1,(now-t0)/dur),v=amount*(1-Math.pow(1-k,3));if(k<1){el.textContent='− '+money(Math.round(v));requestAnimationFrame(step);}else el.textContent='− '+money(amount);};requestAnimationFrame(step);}
  function startTransfer(){if(transferBusy)return;transferBusy=true;vibrate(30);const ov=document.createElement('div');ov.className='processing';ov.innerHTML='<div class="spinner"></div><p>Выполняем перевод…</p>';app.appendChild(ov);setTimeout(()=>{ov.remove();const amount=parseAmount(form.amount);completeTransfer();countUp(amount);vibrate([70,50,140]);transferBusy=false;},1800);}
  function showPush(name,amount){document.querySelectorAll('.push').forEach(x=>x.remove());const el=document.createElement('div');el.className='push';el.innerHTML=`<div class="push-ic">₽</div><div class="push-body"><div class="push-top"><span>OzonБанк</span><span>сейчас</span></div><div class="push-title">Вам поступил перевод</div><div class="push-sum">+${money(amount)}</div><div class="push-sub">от ${e(name)}</div></div>`;app.appendChild(el);requestAnimationFrame(()=>requestAnimationFrame(()=>el.classList.add('show')));vibrate([200,100,200]);const hide=()=>{el.classList.remove('show');setTimeout(()=>el.remove(),500);};el.addEventListener('click',hide);setTimeout(hide,6000);}
  
  function showReceiptModal() {
    if (!selectedTx) return;
    document.querySelectorAll('.receipt-modal').forEach(el => el.remove());
    const wrapper = document.createElement('div');
    wrapper.innerHTML = renderReceiptModal(selectedTx);
    app.appendChild(wrapper.firstElementChild);
  }

  let secretTaps=0,secretTimer;
  function openSecret(){
    if(document.getElementById('secret'))return;
    const d=document.createElement('div');d.id='secret';d.className='secret';
    d.innerHTML=`<div class="secret-box"><h2>Скрытое меню</h2><p class="muted">Текущий баланс: ${money(state.balance)}</p>
      <div class="field-label">Добавить на счёт, ₽</div><div class="field-wrap"><input id="sAdd" inputmode="decimal" placeholder="1000000"></div>
      <div class="secret-row"><button data-add="1000">+1 тыс</button><button data-add="100000">+100 тыс</button><button data-add="1000000">+1 млн</button><button data-add="10000000">+10 млн</button></div>
      <div class="field-label">Или задать точный баланс, ₽</div><div class="field-wrap"><input id="sSet" inputmode="decimal" placeholder="${state.balance}"></div>
      <div class="field-label">Имя в профиле</div><div class="field-wrap"><input id="sName" value="${e(state.user)}" maxlength="30"></div>
      <div class="field-label">Уведомление «Вам поступил перевод»</div><div class="field-wrap"><input id="pName" placeholder="От кого, напр. Иванов А."></div><div class="field-wrap" style="margin-top:8px"><input id="pAmt" inputmode="decimal" placeholder="Сумма, напр. 1000000"></div><label style="display:flex;gap:8px;align-items:center;margin-top:10px;font-size:15px"><input type="checkbox" id="pCredit" checked style="width:20px;height:20px"> Зачислить на счёт</label><div class="secret-row"><button id="pShow">Показать через 3 сек</button></div><button class="big-button" id="sApply">Применить</button><button class="secret-close" id="sClose">Закрыть</button></div>`;
    app.appendChild(d);
    const close=()=>d.remove();
    d.addEventListener('click',ev=>{if(ev.target===d)close();});
    d.querySelectorAll('[data-add]').forEach(b=>b.addEventListener('click',()=>{d.querySelector('#sAdd').value=b.getAttribute('data-add');}));
    d.querySelector('#sClose').addEventListener('click',close);
    d.querySelector('#pShow').addEventListener('click',()=>{const nm=d.querySelector('#pName').value.trim()||'Иванов А.',am=parseAmount(d.querySelector('#pAmt').value)||1000000,cr=d.querySelector('#pCredit').checked;close();toast('Уведомление придёт через 3 сек');setTimeout(()=>{if(cr){state.balance=Math.round((state.balance+am)*100)/100;state.transactions.unshift({id:'ML-'+Date.now().toString(36).toUpperCase(),kind:'credit',amount:am,type:'phone',target:'',name:nm,message:'',date:new Date().toISOString()});save();if(!document.getElementById('secret'))render();}showPush(nm,am);},3000);});
    d.querySelector('#sApply').addEventListener('click',()=>{
      const add=parseAmount(d.querySelector('#sAdd').value),set=d.querySelector('#sSet').value.trim(),name=d.querySelector('#sName').value.trim();
      if(set!==''){state.balance=parseAmount(set);}
      if(add>0){state.balance=Math.round((state.balance+add)*100)/100;state.transactions.unshift({id:'ML-'+Date.now().toString(36).toUpperCase(),kind:'credit',amount:add,type:'phone',target:'',name:'Пополнение счёта',message:'',date:new Date().toISOString()});}
      if(name)state.user=name;
      save();close();render();toast('Готово');
    });
  }
  document.addEventListener('input',event=>{const field=event.target.getAttribute('data-field');if(field&&Object.prototype.hasOwnProperty.call(form,field)){form[field]=event.target.value;const error=document.getElementById('formError');if(error)error.classList.remove('show');}});
  document.addEventListener('click',event=>{if(event.target.closest('.brand')){secretTaps++;clearTimeout(secretTimer);secretTimer=setTimeout(()=>{secretTaps=0;},1500);if(secretTaps>=5){secretTaps=0;openSecret();}}const button=event.target.closest('[data-action]');if(!button)return;const action=button.getAttribute('data-action');const target=button.getAttribute('data-target');
    if(action==='tab'){tab(target);return;}if(action==='back'){back();return;}if(action==='transfer'){form=freshForm(target==='card'?'card':'phone');navigate('transfer');return;}if(action==='continue'){const error=validate();if(error){const box=document.getElementById('formError');box.textContent=error;box.classList.add('show');box.scrollIntoView({block:'nearest',behavior:'smooth'});return;}navigate('confirm');return;}if(action==='confirm'){startTransfer();return;}if(action==='done'){tab('home');return;}if(action==='history'){navigate('history');return;}if(action==='tx'){selectedTx=state.transactions.find(t=>t.id===button.getAttribute('data-id'));navigate('tx-detail');return;}if(action==='reset'){resetQuest();return;}
    if(action==='receipt'){showReceiptModal();return;}
    if(action==='close-receipt'){const m=document.getElementById('receiptModal');if(m)m.remove();return;}
    if(action==='share-receipt'){toast('Квитанция сохранена в PDF');return;}
    if(action==='repeat'){if(!selectedTx)return;form=freshForm(selectedTx.type);form.surname=selectedTx.name.split(' ')[0]||'';form.initial=(selectedTx.name.split(' ')[1]||'').replace('.','');form.amount=String(selectedTx.amount);navigate('transfer');return;}
    if(action==='tx-document'){navigate('tx-detail');return;}
    const messages={qr:'Сканирование QR сейчас недоступно.',topup:'Пополнение временно недоступно.','new-product':'Скоро появятся новые продукты.',gift:'Бонусы скоро появятся.',search:'Для поиска используйте раздел «Платежи».',template:'Шаблоны скоро появятся.',autopay:'Автоплатежи скоро появятся.', 'my-phone':'Выберите перевод по номеру телефона.', 'own-accounts':'Доступен основной счёт.',foreign:'Переводы за рубеж временно недоступны.',service:button.dataset.label+' — скоро.',help:'Проведите перевод через раздел «Платежи».',about:'OzonБанк, версия 1.0','tx-document':'Детали операции доступны в истории.'};if(messages[action])toast(messages[action]);
  });
  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&!['home','payments','benefits','chats','more'].includes(page))back();});
  window.addEventListener('popstate',()=>back());
  window.QuestBankBack=back;
  render();
})();
</script>
